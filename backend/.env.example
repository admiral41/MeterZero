# Copy this file to .env (same folder) and fill it in. The server reads it when it starts.
# .env is ignored by git and never copied into the container image.

# A Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use
# GEMINI_MODEL=gemini-3.8-flash

# Your Google Cloud project (ID or number). deploy.ps1 reads it from here.
GOOGLE_CLOUD_PROJECT=

# Or use Vertex AI on Google Cloud instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global
